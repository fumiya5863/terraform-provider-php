{
    "name": "fumiya5863/terraform-provider-php",
    "description": "Terraform の plugin protocol を PHP で実装した実験",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "google/protobuf": "^4.0"
    },
    "autoload": {
        "psr-4": {
